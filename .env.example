# ==============================================================================
# Industrial Incident Investigator - Environment Configuration
# ==============================================================================

# Groq API Configuration (for Query Rewriting & Grounded Answer Generation)
# Obtain your free API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding & Cross-Encoder Models (HuggingFace / Sentence Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage & Indexing Paths
QDRANT_PATH=data/processed/qdrant_db
QDRANT_COLLECTION_NAME=incident_chunks
BM25_INDEX_PATH=data/processed/bm25_index.pkl
DOCUMENT_STORE_PATH=data/processed/documents.json

# Text Chunking Settings
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# Retrieval & Fusion Parameters
DENSE_TOP_K=10
BM25_TOP_K=10
RRF_K=60
RERANK_TOP_K=5
FINAL_CONTEXT_K=5

# Query Rewriting
QUERY_REWRITING_ENABLED=true
NUM_QUERY_REWRITES=3

# Backend & Server Settings
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Logging & Environment
LOG_LEVEL=INFO
ENVIRONMENT=development
