# ==============================================================================
# Streamlit Community Cloud Secrets (or local .streamlit/secrets.toml)
# ==============================================================================
# In Streamlit Community Cloud:
# Go to: App Dashboard -> App Settings (gear icon or 3 dots) -> Secrets
#
# If connecting the public Streamlit app to your local FastAPI backend via tunnel (e.g. ngrok or localtunnel):
# BACKEND_URL = "https://your-tunnel-url.loca.lt"
#
# If running single-container mode directly on Streamlit Cloud, leave BACKEND_URL empty
# and the app will spawn FastAPI internally.

GROQ_API_KEY = "gsk_..."

